<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Lustria&display=swap" rel="stylesheet">
{{ 'gift-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bonus_product = section.settings.bonus_product
  assign trigger_1 = section.settings.trigger_value_1 | strip | downcase
  assign trigger_2 = section.settings.trigger_value_2 | strip | downcase
  assign bonus_variant = bonus_product.selected_or_first_available_variant
-%}

<div
  class="gift-grid"
  data-trigger1="{{ trigger_1 }}"
  data-trigger2="{{ trigger_2 }}"
  {% if bonus_variant %}data-bonus-variant-id="{{ bonus_variant.id }}"{% endif %}
  style="
    --gg-dark: {{ section.settings.dark_color }};
    --gg-light: {{ section.settings.light_color }};
    --gg-accent: {{ section.settings.accent_color }};
    --gg-title-size-desktop: {{ section.settings.popup_title_size_desktop }}px;
    --gg-title-size-mobile: {{ section.settings.popup_title_size_mobile }}px;
    --gg-price-size-desktop: {{ section.settings.popup_price_size_desktop }}px;
    --gg-price-size-mobile: {{ section.settings.popup_price_size_mobile }}px;
    --gg-description-size-desktop: {{ section.settings.popup_description_size_desktop }}px;
    --gg-description-size-mobile: {{ section.settings.popup_description_size_mobile }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="gift-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="gift-grid__grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        {%- assign tile_image = block.settings.image | default: product.featured_image -%}
        <div class="gift-grid__tile" {{ block.shopify_attributes }}>
          <div class="gift-grid__image-wrap">
            {%- if tile_image != blank -%}
              <img
                class="gift-grid__image"
                src="{{ tile_image | image_url: width: 1000 }}"
                srcset="{{ tile_image | image_url: width: 500 }} 500w, {{ tile_image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 750px) 33vw, 50vw"
                alt="{{ tile_image.alt | default: product.title | escape }}"
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>

          <div class="gift-grid__anchor" style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;">
            <button
              type="button"
              class="gift-grid__hotspot"
              data-gift-grid-hotspot
              aria-expanded="false"
              aria-label="Quick view {{ product.title | escape }}"
            >
              <span class="gift-grid__hotspot-icon" aria-hidden="true">
                <span class="gift-grid__hotspot-plus">+</span>
                <span class="gift-grid__hotspot-close">&times;</span>
              </span>
            </button>

            <div class="gift-grid__mini" data-gift-grid-mini hidden>
              <div class="gift-grid__mini-card" data-gift-grid-mini-card role="button" tabindex="0">
                {%- if tile_image != blank -%}
                  <img class="gift-grid__mini-image" src="{{ tile_image | image_url: width: 200 }}" alt="" width="60" height="60">
                {%- endif -%}
                <div class="gift-grid__mini-info">
                  <p class="gift-grid__mini-title">{{ product.title }}</p>
                  <p class="gift-grid__mini-price">{{ product.price | money }}</p>
                </div>
              </div>
            </div>
          </div>

          {%- capture variants_json -%}
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id | json }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | money | json }},
                  "options": {{ variant.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          {%- endcapture -%}

          {%- capture options_json -%}
            [
              {%- for option in product.options_with_values -%}
                { "name": {{ option.name | json }}, "values": {{ option.values | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          {%- endcapture -%}

          <script type="application/json" data-product-json>
            {
              "title": {{ product.title | json }},
              "price": {{ product.price | money | json }},
              "description": {{ product.description | json }},
              "image": {{ tile_image | image_url: width: 1200 | json }},
              "options": {{ options_json }},
              "variants": {{ variants_json }}
            }
          </script>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="gift-grid__overlay" data-gift-grid-overlay hidden>
    <div class="gift-grid__backdrop" data-gift-grid-backdrop></div>

    <div class="gift-grid__popup gift-grid__popup--modal" data-gift-grid-modal hidden>
      <div class="gift-grid__modal-card">
        <button type="button" class="gift-grid__close" data-gift-grid-close aria-label="Close">
          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="gift-grid__modal-top">
          <img class="gift-grid__modal-image" data-gift-grid-modal-image alt="" width="70" height="86">
          <div class="gift-grid__modal-info">
            <p class="gift-grid__modal-title" data-gift-grid-modal-title></p>
            <p class="gift-grid__modal-price" data-gift-grid-modal-price></p>
            <div class="gift-grid__modal-description" data-gift-grid-modal-description></div>
          </div>
        </div>
        <div class="gift-grid__modal-options" data-gift-grid-modal-options></div>
        <p class="gift-grid__modal-message" data-gift-grid-modal-message hidden></p>
        <button type="button" class="gift-grid__btn" data-gift-grid-add-to-cart disabled>
          <span class="gift-grid__btn-fill" aria-hidden="true"></span>
          <span class="gift-grid__btn-label">Add to cart</span>
          <span class="gift-grid__btn-icon" aria-hidden="true">
            <svg class="gift-grid__arrow--base" viewBox="0 0 34 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 6H33M33 6L27 1M33 6L27 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="gift-grid__arrow--hover" viewBox="0 0 34 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 6H33M33 6L27 1M33 6L27 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'gift-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Gift grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Only shown on mobile, matching Figma - desktop has no heading here.",
      "default": "Tisso vison in the wild"
    },
    { "type": "header", "content": "Cross-sell rule" },
    {
      "type": "paragraph",
      "content": "When the customer's selected variant matches both trigger values below, the bonus product is added to the cart alongside it automatically."
    },
    { "type": "product", "id": "bonus_product", "label": "Bonus product", "info": "e.g. Soft Winter Jacket" },
    { "type": "text", "id": "trigger_value_1", "label": "Trigger option value 1", "default": "Black" },
    { "type": "text", "id": "trigger_value_2", "label": "Trigger option value 2", "default": "Medium" },
    { "type": "header", "content": "Popup typography" },
    { "type": "paragraph", "content": "Font sizes for the quick-view popup's title, price, and description - set separately for desktop and mobile." },
    { "type": "range", "id": "popup_title_size_desktop", "label": "Title size (desktop)", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "popup_title_size_mobile", "label": "Title size (mobile)", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "popup_price_size_desktop", "label": "Price size (desktop)", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "popup_price_size_mobile", "label": "Price size (mobile)", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "popup_description_size_desktop", "label": "Description size (desktop)", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "popup_description_size_mobile", "label": "Description size (mobile)", "min": 8, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "dark_color", "label": "Dark color", "default": "#000000" },
    { "type": "color", "id": "light_color", "label": "Light color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#FFF544" }
  ],
  "blocks": [
    {
      "type": "product_tile",
      "name": "Product tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom tile image",
          "info": "Optional. Defaults to the product's featured image."
        },
        { "type": "range", "id": "hotspot_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "hotspot_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift grid",
      "blocks": [
        { "type": "product_tile" },
        { "type": "product_tile" },
        { "type": "product_tile" },
        { "type": "product_tile" },
        { "type": "product_tile" },
        { "type": "product_tile" }
      ]
    }
  ]
}
{% endschema %}
