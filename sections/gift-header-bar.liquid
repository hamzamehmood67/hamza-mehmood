<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign button_link = section.settings.button_link
-%}

<div class="gift-header-bar" id="gift-header-bar-{{ section.id }}">
  <div class="gift-header-bar__row">
    <button
      type="button"
      class="gift-header-bar__toggle"
      aria-expanded="false"
      aria-controls="gift-header-bar-panel-{{ section.id }}"
    >
      <span class="gift-header-bar__toggle-icon" aria-hidden="true">
        <svg class="gift-header-bar__icon-burger" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 1H18M0 7H18M0 13H18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <svg class="gift-header-bar__icon-close" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="visually-hidden">Menu</span>
    </button>

    {%- if section.settings.logo_text != blank -%}
      <p class="gift-header-bar__logo">{{ section.settings.logo_text }}</p>
    {%- endif -%}
  </div>

  <div class="gift-header-bar__panel" id="gift-header-bar-panel-{{ section.id }}">
    <div class="gift-header-bar__panel-inner">
      {%- if section.settings.middle_text != blank -%}
        <p class="gift-header-bar__text">{{ section.settings.middle_text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if button_link != blank %}href="{{ button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="gift-header-bar__btn"
        >
          <span class="gift-header-bar__btn-fill" aria-hidden="true"></span>
          <span class="gift-header-bar__btn-label">{{ section.settings.button_label }}</span>
          <span class="gift-header-bar__btn-icon" aria-hidden="true">
            {%- render 'gift-banner-arrow', class: 'gift-header-bar__arrow--base' -%}
            {%- render 'gift-banner-arrow', class: 'gift-header-bar__arrow--hover' -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('gift-header-bar-{{ section.id }}');
    if (!root) return;
    var toggle = root.querySelector('.gift-header-bar__toggle');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
      var isOpen = root.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  })();
</script>

{% style %}
  #gift-header-bar-{{ section.id }} {
    --ghb-dark: {{ section.settings.dark_color }};
    --ghb-light: {{ section.settings.light_color }};
    --ghb-accent: {{ section.settings.accent_color }};
    --ghb-bg: {{ section.settings.bar_bg }};
  }
{% endstyle %}

{% stylesheet %}
  .gift-header-bar {
    --ghb-side-pad: clamp(20px, 9.5vw, 190px);
    font-family: 'Jost', sans-serif;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px var(--ghb-side-pad);
    background: var(--ghb-bg);
  }

  .gift-header-bar * {
    box-sizing: border-box;
  }

  .gift-header-bar__row,
  .gift-header-bar__panel,
  .gift-header-bar__panel-inner {
    display: contents;
  }

  .gift-header-bar__toggle {
    display: none;
  }

  .gift-header-bar__logo {
    margin: 0;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ghb-dark);
    white-space: nowrap;
  }

  .gift-header-bar__text {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    color: var(--ghb-dark);
    text-align: center;
    flex: 1;
  }

  /* ---- button + hover fill animation ---- */
  .gift-header-bar__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 28px;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    font-family: 'Jost', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    background: var(--ghb-accent);
    color: var(--ghb-dark);
    transition: color 0.45s ease;
  }

  .gift-header-bar__btn-fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ghb-dark);
    transform: translateX(-100%);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .gift-header-bar__btn:hover .gift-header-bar__btn-fill {
    transform: translateX(0);
  }

  .gift-header-bar__btn:hover {
    color: var(--ghb-light);
  }

  .gift-header-bar__btn-icon {
    position: relative;
    width: 18px;
    height: 12px;
  }

  .gift-header-bar__btn-icon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* each arrow keeps a fixed color for its state so the crossfade reads as a
     color swap rather than both icons animating through the transition together */
  .gift-header-bar__arrow--base {
    color: var(--ghb-dark);
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.25s ease 0.18s, transform 0.3s ease 0.18s;
  }

  .gift-header-bar__arrow--hover {
    color: var(--ghb-light);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .gift-header-bar__btn:hover .gift-header-bar__arrow--base {
    opacity: 0;
    transform: translateX(10px);
    transition-delay: 0s;
  }

  .gift-header-bar__btn:hover .gift-header-bar__arrow--hover {
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0.18s;
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-header-bar__btn-fill,
    .gift-header-bar__arrow--base,
    .gift-header-bar__arrow--hover {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .gift-header-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }

    .gift-header-bar__row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 16px 20px;
    }

    .gift-header-bar__toggle {
      display: inline-flex;
      justify-self: start;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--ghb-dark);
      cursor: pointer;
    }

    .gift-header-bar__toggle-icon {
      position: relative;
      width: 18px;
      height: 14px;
    }

    .gift-header-bar__toggle-icon svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transition: opacity 0.2s ease, transform 0.25s ease;
    }

    .gift-header-bar__icon-close {
      opacity: 0;
      transform: rotate(-45deg) scale(0.7);
    }

    .gift-header-bar.is-open .gift-header-bar__icon-burger {
      opacity: 0;
      transform: rotate(45deg) scale(0.7);
    }

    .gift-header-bar.is-open .gift-header-bar__icon-close {
      opacity: 1;
      transform: rotate(0) scale(1);
    }

    .gift-header-bar__logo {
      grid-column: 2;
      justify-self: center;
      font-size: 16px;
    }

    .gift-header-bar__panel {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows 0.35s ease, opacity 0.25s ease;
    }

    .gift-header-bar__panel-inner {
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
    }

    .gift-header-bar.is-open .gift-header-bar__panel {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .gift-header-bar__panel .gift-header-bar__text {
      text-align: left;
      font-size: 13px;
      padding: 0 20px 14px;
    }

    .gift-header-bar__panel .gift-header-bar__btn {
      margin: 0 20px 20px;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift header bar",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "TISSO VISON" },
    { "type": "text", "id": "middle_text", "label": "Middle text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bar_bg", "label": "Background", "default": "#F5F5F5" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "dark_color", "label": "Dark color", "default": "#000000" },
    { "type": "color", "id": "light_color", "label": "Light color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#FFF544" }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
